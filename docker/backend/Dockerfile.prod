FROM node:22-alpine AS workspace
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json

FROM workspace AS build
RUN HUSKY=0 pnpm --filter @careerpilot/backend install --frozen-lockfile
COPY apps/backend apps/backend
RUN pnpm --filter @careerpilot/backend build

FROM workspace AS production-deps
RUN pnpm --filter @careerpilot/backend install --frozen-lockfile --prod --ignore-scripts

FROM node:22-alpine AS runtime
WORKDIR /workspace/apps/backend
ENV NODE_ENV=production
COPY --from=build /workspace/apps/backend/dist ./dist
COPY --from=build /workspace/apps/backend/package.json ./package.json
COPY --from=production-deps /workspace/node_modules /workspace/node_modules
COPY --from=production-deps /workspace/apps/backend/node_modules ./node_modules
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
